{
  "name": "sicc-admin",
  "version": "4.0.0",
  "private": true,
  "description": "SICC Admin: secure church administration portal for Salem International Christian Centre",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "design-lint": "node scripts/design-lint.mjs",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js server/tests/unit/*.test.js",
    "test:unit": "node --test server/tests/unit/*.test.js",
    "backup": "node server/scripts/backup.js",
    "restore-check": "node server/scripts/restore-check.js",
    "vapid": "node server/scripts/vapid.js",
    "test:ui": "vitest run",
    "test:all": "npm test && npm run test:ui",
    "test:smoke": "node scripts/tests/smoke.mjs",
    "find-duplicates": "node server/scripts/find-duplicates.js",
    "import-members": "node server/scripts/import-member-register.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.383.0",
    "mysql2": "^3.12.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.12.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^31.0.1",
    "supertest": "^7.0.0",
    "vite": "^6.4.1",
    "vitest": "^5.1.1"
  }
}
