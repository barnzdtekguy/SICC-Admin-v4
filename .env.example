# ───────────── Required ─────────────
NODE_ENV=development
PORT=3001
# Database (Hostinger hPanel > Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# 64+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Separate key used to encrypt stored secrets (SMS key, MFA secrets). Generate the same way. Keep it safe:
# if you lose it, encrypted values (SMS key, authenticator secrets) cannot be recovered.
DATA_ENCRYPTION_KEY=

# ───────────── First run only ─────────────
# Creates the first Bishop account when the database has no users. It must change this password at first sign-in.
# Delete these three lines after the first successful login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
# bishop (default) or admin. Only a Bishop can create other Bishop/Admin accounts, so start with bishop unless you know why not.
INITIAL_ADMIN_ROLE=bishop

# ───────────── Recommended ─────────────
# Local browser origin. In production, set this to your public HTTPS site address.
APP_ORIGIN=http://localhost:3000
# Number of proxies in front of Node (Hostinger: 1)
TRUST_PROXY=1
# Optional: Slack/Discord/Teams webhook that receives alerts (server errors, account lockouts)
ALERT_WEBHOOK_URL=
# Backups: set a passphrase so backup files are encrypted
BACKUP_PASSPHRASE=
BACKUP_DIR=backups
BACKUP_KEEP=14

# ───────────── Tuning (defaults shown) ─────────────
SESSION_TTL_HOURS=10
SESSION_REMEMBER_DAYS=14
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
MFA_REQUIRED_ROLES=bishop,admin
ATTENDANCE_LOCK_HOURS=48
ATTENDANCE_BACKDATE_DAYS=3
CHECKIN_ROTATE_SECONDS=60
CHECKIN_MAX_PER_DEVICE=2
CONSENT_REQUIRED=true

# ───────────── Optional integrations ─────────────
# SMS provider endpoint (BulkSMSNigeria-compatible). The API key itself is saved in Settings, encrypted.
SMS_API_URL=https://www.bulksmsnigeria.com/api/v1/sms/create
AUTO_BIRTHDAY_SMS=false
# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Browser push notifications:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.org
